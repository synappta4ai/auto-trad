# ==============================================================================
#  AUTOTRADER — copia este archivo a .env y ajusta.   cp .env.example .env
#  Después de cambiar algo:  docker compose up -d     (recrea el contenedor; el estado se conserva)
#  Valores con coma = el optimizador prueba todas las combinaciones.  Un solo valor = fijo.
# ==============================================================================

# ------------------------------- DOCKER / SERVIDOR ----------------------------
# nombre del contenedor
CONTAINER_NAME=autotrader
IMAGE_NAME=autotrader:latest
# puerto publicado en el servidor
API_PORT=8080
# API_BIND aplica a la ejecución LOCAL (uv run / python -m app.main).
# En Docker el contenedor siempre escucha en 0.0.0.0:8080.
# 127.0.0.1 = solo local (recomendado, usa túnel SSH/reverse proxy). 0.0.0.0 = abierto
API_BIND=127.0.0.1
# interfaz del HOST que publica el contenedor (docker compose)
API_HOST_BIND=127.0.0.1
# cabecera X-API-Token para la API. Vacío = se genera uno temporal (ver logs)
API_TOKEN=cambia-esto-por-un-token-largo
# true = el motor arranca solo al iniciar el proceso
AUTO_START=true
# carpeta de la base SQLite (./data en local; /data en Docker)
DATA_DIR=./data
# volumen con la base SQLite (estado, trades, eventos)
VOLUME_NAME=autotrader_data
RESTART_POLICY=unless-stopped
CPU_LIMIT=1.0
MEM_LIMIT=1g
TZ=UTC
LOG_LEVEL=INFO

# ------------------------------- MODO -----------------------------------------
# paper = simulado (sin dinero real) | live = órdenes REALES
MODE=paper
# para MODE=live escribe exactamente: I_UNDERSTAND_THE_RISK
LIVE_CONFIRM=

# ------------------------------- DATOS / EXCHANGE -----------------------------
# synthetic = demo sin red | exchange = velas reales vía ccxt
DATA_SOURCE=synthetic
# cualquier id de ccxt (binance, bybit, kraken, okx...)
EXCHANGE=binance
# usa el testnet del exchange. Déjalo en true hasta validar todo
EXCHANGE_SANDBOX=true
# solo permiso de TRADING, nunca de retiro
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# solo algunos exchanges (okx, kucoin...)
EXCHANGE_API_PASSWORD=
# misma moneda cotizada para todos
SYMBOLS=BTC/USDT,ETH/USDT
# 5m, 15m, 1h, 4h, 1d ...
TIMEFRAME=1h
# velas que se cargan (debe cubrir TRAIN+FOLDS*TEST+200)
HISTORY_BARS=3000
# cada cuánto revisa precios/stops
POLL_SECONDS=20
# 0 = automático (mercado 24/7). Para forex/acciones ponlo a mano
BARS_PER_YEAR=0
# solo DATA_SOURCE=synthetic
SYNTHETIC_SEED=7
# en synthetic, velas simuladas que avanzan por ciclo (demo acelerada)
SYNTHETIC_BARS_PER_POLL=1

# ------------------------------- CAPITAL Y COSTOS -----------------------------
# capital ASIGNADO al bot (en live nunca usa más que esto)
INITIAL_CAPITAL=1000
# comisión por lado (%)
FEE_PCT=0.10
# deslizamiento por lado (%)
SLIPPAGE_PCT=0.05
# spread total (%)
SPREAD_PCT=0.02
# cortos: solo en paper (live es spot long-only)
ALLOW_SHORT=false
# false = no entra a mitad de tendencia al arrancar; espera la próxima señal nueva
ENTER_ON_START=false

# ------------------------------- ESTRATEGIAS ----------------------------------
# Disponibles: ema_cross, rsi_reversion, breakout, ml_logit
STRATEGIES=ema_cross,rsi_reversion,breakout,ml_logit
# solo si LEARNING_ENABLED=false: estrategia fija (usa el 1er valor de cada rejilla)
FIXED_STRATEGY=
# ema_cross
EMA_FAST=8,12,20
EMA_SLOW=30,50,100
# rsi_reversion
RSI_PERIOD=14
RSI_LOW=25,30
RSI_HIGH=70,75
RSI_EXIT=50
# breakout (Donchian)
BREAKOUT_LOOKBACK=20,40,80
BREAKOUT_EXIT_RATIO=0.5
# ml_logit (regresión logística con reentreno rodante)
ML_TRAIN_BARS=600,1000
# margen sobre 50% de probabilidad para operar
ML_THRESHOLD=0.03,0.06
# velas hacia adelante que intenta predecir
ML_HORIZON=4
# cada cuántas velas reajusta el modelo
ML_REFIT_BARS=50
ML_L2=0.05

# ------------------------------- RIESGO / TOPES --------------------------------
# % del equity que se arriesga por operación (hasta el stop)
RISK_PER_TRADE_PCT=0.5
# tope de nocional por posición (% equity)
MAX_POSITION_PCT=25
# tope de exposición total (% equity)
MAX_TOTAL_EXPOSURE_PCT=60
MAX_OPEN_POSITIONS=3
ATR_PERIOD=14
# stop = ATR * este valor
STOP_ATR_MULT=2.0
# 0 = sin take profit (sale por señal). 2 = TP a 2x el riesgo
TAKE_PROFIT_RR=0
# pérdida diaria -> pausa entradas hasta el día UTC siguiente
MAX_DAILY_LOSS_PCT=3
# pérdida semanal -> pausa entradas hasta la semana siguiente
MAX_WEEKLY_LOSS_PCT=6
# KILL SWITCH: detiene todo hasta POST /resume
MAX_DRAWDOWN_PCT=15
MAX_TRADES_PER_DAY=10
# velas de espera tras una operación perdedora
COOLDOWN_BARS=2
# tras un stop no re-entra hasta que la señal se reinicie
REENTRY_AFTER_STOP_REQUIRES_RESET=true
# nocional mínimo por orden
MIN_NOTIONAL=10
# el kill switch cierra posiciones abiertas
KILL_SWITCH_CLOSE_POSITIONS=true

# ------------------------------- PROTECCIÓN EN VIVO / VIGILANCIA --------------
# stop de protección colocado EN el exchange: sigue vivo si este proceso cae.
# Solo aplica a MODE=live (en paper el stop es software)
NATIVE_STOPS=true
# al arrancar en live: cancela órdenes huérfanas y ajusta el estado al exchange
# (nunca inventa posiciones a partir del saldo; solo corrige hacia abajo)
RECONCILE_ON_START=true
# prefijo de los client order id (1-8 caracteres). No lo cambies con posiciones abiertas
CLIENT_ID_PREFIX=at
# watchdog: avisa si el ciclo del motor deja de avanzar
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_SECONDS=30
# sin señal de vida (tick o progreso de entrenamiento) durante estos segundos = alerta
# debe ser mayor que POLL_SECONDS
WATCHDOG_STALL_SECONDS=600
# false = solo avisa. true = cierra todo lo abierto cuando el ciclo se atasca
WATCHDOG_FLATTEN=false

# ------------------------------- DESDE EL PANEL WEB --------------------------
# Todo lo de arriba (salvo las claves, API_TOKEN y LIVE_CONFIRM) se puede editar
# en http://127.0.0.1:8080/ui -> Configuración. El panel reescribe SOLO la clave
# que cambias en este archivo, conserva los comentarios y deja una copia en .env.bak.
# Lo marcado como "reinicio" (MODE, DATA_SOURCE, EXCHANGE, TIMEFRAME, API_PORT,
# INITIAL_CAPITAL, CLIENT_ID_PREFIX, WATCHDOG_ENABLED) se aplica al reiniciar el
# proceso; el resto entra en el siguiente ciclo.

# ------------------------------- APRENDIZAJE (walk-forward) -------------------
# false = estrategia fija, sin reentrenar
LEARNING_ENABLED=true
# reentrena al pulsar Iniciar / arrancar el proceso
RETRAIN_ON_START=true
# scheduled = cada RETRAIN_INTERVAL_HOURS | continuous = reentrena sin parar
TRAIN_MODE=scheduled
# segundos de espera entre entrenamientos en modo continuo (mínimo 60)
TRAIN_COOLDOWN_SECONDS=600
# velas nuevas exigidas para reentrenar en continuo (1 = cada vela nueva; 0 = no esperar)
TRAIN_MIN_NEW_BARS=1
# reentrenamiento programado (168 = semanal). En demo synthetic usa 0.25 (15 min)
RETRAIN_INTERVAL_HOURS=168
# velas para elegir parámetros en cada fold
TRAIN_WINDOW_BARS=1500
# velas fuera de muestra por fold
TEST_WINDOW_BARS=300
# número de folds walk-forward
WF_FOLDS=3
# Umbrales que debe pasar el OOS agregado para que algo opere. Si no pasa: queda en liquidez.
MIN_OOS_TRADES=8
MIN_OOS_SHARPE=0.5
MIN_OOS_PROFIT_FACTOR=1.1
MAX_OOS_DRAWDOWN_PCT=20
# el retador debe superar al campeón por este % para reemplazarlo
PROMOTE_MARGIN_PCT=10
# si el OOS falla, retira al campeón actual (símbolo en liquidez)
DEMOTE_ON_FAIL=true
# tope de combinaciones por entrenamiento (muestreo aleatorio si se excede)
MAX_CANDIDATES=400
# núcleos para repartir los candidatos del walk-forward: 0 = automático (solo si
# hay trabajo suficiente), 1 = siempre en serie
PARALLEL_WORKERS=0
# el OOS simula la ejecución real (stop, sizing, topes, costos), no solo la señal.
# combinaciones mínimas por fold en la ventana de entrenamiento
MIN_TRAIN_TRADES=5
# velas de separación entre train y test (0 = automático = ML_HORIZON),
# evita que las etiquetas solapadas del modelo filtren el test al train
EMBARGO_BARS=0
# además de las puertas, exigir que el OOS supere a comprar y mantener el activo
REQUIRE_BEAT_BENCHMARK=false

# ------------------------------- AUTOAJUSTE (deriva y riesgo) -----------------
# reentrena antes de tiempo si detecta deriva
RETRAIN_ON_DRIFT=true
# volatilidad corta/larga >= esto (o <= 1/esto) = deriva
DRIFT_VOL_RATIO=2.0
DRIFT_SHORT_BARS=24
DRIFT_LONG_BARS=240
# N pérdidas seguidas = deriva (0 = desactivado)
DRIFT_LOSS_STREAK=5
# separación mínima entre reentrenamientos por deriva
DRIFT_MIN_HOURS=12
# reduce el riesgo cuando la volatilidad se dispara
VOL_SCALING_ENABLED=true
# reduce el riesgo al acercarse al drawdown máximo
DERISK_ENABLED=true
# drawdown a partir del cual empieza a reducir
DERISK_START_DD_PCT=5
# multiplicador mínimo de riesgo por drawdown
DERISK_MIN_MULT=0.25
# límites del multiplicador final de riesgo
RISK_MULT_MIN=0.25
RISK_MULT_MAX=1.0
# frecuencia de la curva de equity guardada
EQUITY_LOG_SECONDS=300
