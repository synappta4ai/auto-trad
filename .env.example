# ==============================================================================
#  AUTOTRADER — SOLO ARRANQUE.   cp .env.example .env
#
#  El resto de la configuración (mercado, capital, riesgo, aprendizaje, rejillas)
#  se edita en el panel /config y vive en la tabla `settings` de la base SQLite.
#  En el primer arranque se migra a la base lo que haya en el entorno; a partir
#  de ahí la base manda y este fichero solo aporta lo necesario para abrirla.
# ==============================================================================

# ------------------------------- DOCKER / SERVIDOR ----------------------------
CONTAINER_NAME=autotrader
IMAGE_NAME=autotrader:latest
# puerto publicado en el servidor (debe coincidir con el del panel)
API_PORT=8080
# 127.0.0.1 = solo local (usa túnel SSH/reverse proxy). 0.0.0.0 = abierto
API_BIND=127.0.0.1
# interfaz del HOST que publica el contenedor (docker compose)
API_HOST_BIND=127.0.0.1
VOLUME_NAME=autotrader_data
RESTART_POLICY=unless-stopped
CPU_LIMIT=1.0
MEM_LIMIT=1g
TZ=UTC
LOG_LEVEL=INFO

# ------------------------------- ARRANQUE -------------------------------------
# carpeta de la base SQLite (./data en local; /data en Docker)
DATA_DIR=./data
# true = el motor arranca solo al iniciar el proceso
AUTO_START=true
# walk-forward al arrancar (o al pulsar Iniciar)
RETRAIN_ON_START=true

# ------------------------------- ACCESO ---------------------------------------
# usuario y contraseña del panel (HTTP Basic: el navegador lo pide una vez).
# Sin ellos, el panel solo acepta la cabecera X-API-Token.
PANEL_USER=demo
PANEL_PASSWORD=cambia-esta-clave
# token para scripts/curl: cabecera  X-API-Token: <valor>
# vacío = se genera uno temporal en cada arranque (sale en el log)
API_TOKEN=cambia-esto-por-un-token-largo

# ------------------------------- EXCHANGE (live) ------------------------------
# MODE=live se activa en el panel; estas claves, no (nunca se editan desde la web).
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=
# frase exacta que habilita órdenes reales: I_UNDERSTAND_THE_RISK
LIVE_CONFIRM=
